# Copy to .env and run the API with: uv run --env-file .env serve
# Required by the default model. PydanticAI reads it from the process env.
OPENROUTER_API_KEY=
# Hides the banner PydanticAI prints on the first agent run.
PYDANTIC_AI_NO_BANNER=1

# Optional; the defaults are shown.
# CSV_PATH=data/orders_raw.csv
# DB_PATH=data/orders.db
# LLM_MODEL=openrouter:anthropic/claude-sonnet-5.5
# LLM_TIMEOUT=30
# QUERY_TIMEOUT=5
# API_HOST=127.0.0.1
# API_PORT=8000
